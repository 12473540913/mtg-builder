# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority

# Auth
# Must match auth-service's JWT_SECRET and AUTH_COOKIE_NAME exactly
# verifies the token auth-service issues, it never signs its own. 
# Domain is set so this cookie reaches api.mtg-builder.lnks.info.
JWT_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=auth_session
AUTH_COOKIE_DOMAIN_MTG_BUILDER=.lnks.info 

# Server runtime
# Comma-separated list of allowed CORS origins (leave unset in dev = allow all)
# Cloud Run injects PORT automatically.
NODE_ENV=production
ALLOWED_ORIGINS=https://mtg-builder.lnks.info
