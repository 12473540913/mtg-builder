# auth-service base URL (frontend calls it directly, credentials: "include")
# VITE_AUTH_BASE_URL=https://auth.lnks.info

# MongoDB Atlas connection (server) — mtg-builder's own data only, no user/auth collections
# Must be the SAME database auth-service's ATLAS_URI_MTGBUILDER points at.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority
# MONGODB_DB_NAME=mtg-builder

# Must match auth-service's JWT_SECRET and AUTH_COOKIE_NAME exactly — mtg-builder-api only
# verifies the token auth-service issues, it never signs its own. auth-service must also
# set AUTH_COOKIE_DOMAIN_MTGBUILDER=.lnks.info so this cookie reaches api.mtg-builder.lnks.info.
JWT_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=auth_session

# ── API base URL (frontend) ───────────────────────────────────────────────────
# Leave empty in dev — Vite proxies /api/* to localhost:3001 automatically.
# In production (Cloudflare Pages), set this to your Cloud Run backend URL:
#   VITE_API_BASE_URL=https://api.mtg-builder.lnks.info
VITE_API_BASE_URL=apiURL

# ── Server runtime ────────────────────────────────────────────────────────────
# PORT=3001
# NODE_ENV=development
# Comma-separated list of allowed CORS origins (leave unset in dev = allow all)
# ALLOWED_ORIGINS=https://mtg-builder.lnks.info
