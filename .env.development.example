# auth-service base URL (frontend calls it directly)
VITE_AUTH_BASE_URL=https://auth-dev.lnks.info

# Database
# Must be the same as the string in google cloud run auth-dev
MONGODB_URI=string-here

# Auth
# Must match JWT_SECRET and AUTH_COOKIE_NAME exactly in google cloud run auth-dev
# It verifies the token auth-service issues, it never signs its own
JWT_SECRET=secret
AUTH_COOKIE_NAME=auth_session
