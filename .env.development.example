# auth-service base URL (frontend calls it directly, credentials: "include")
# Dev: the auth-service's dev Cloud Run URL (see auth-service README for the current one).
# VITE_AUTH_BASE_URL=https://auth-dev-46917854791.us-central1.run.app

# Frontend -> backend API base (optional in dev with Vite proxy)
# VITE_API_BASE_URL=http://localhost:3001

# MongoDB Atlas connection (server) — mtg-builder's own data only, no user/auth collections
# Must be the SAME database auth-service's ATLAS_URI_MTGBUILDER points at, so `users` lookups
# in server/index.ts see the accounts auth-service creates.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority
# Only needed if MONGODB_URI doesn't already include a database name.
# MONGODB_DB_NAME=mtg-builder

# Must match auth-service's JWT_SECRET and AUTH_COOKIE_NAME exactly — mtg-builder-api only
# verifies the token auth-service issues, it never signs its own.
JWT_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=auth_session
